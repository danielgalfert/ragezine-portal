# Set to sqlite to use backend/db.sqlite3 without PostgreSQL.
DJANGO_DB_ENGINE=postgres

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_MEDIA_URL=/media/
RAGEZINE_STORAGE_BACKEND=local
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# S3-compatible storage, for later:
# RAGEZINE_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=auto
# AWS_QUERYSTRING_AUTH=1

POSTGRES_DB=submissions
POSTGRES_USER=ragezine
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

SUBMISSION_EMAIL_FROM=no-reply@example.com
SUBMISSION_EMAIL_SUBJECT=Thank you for submitting to Rage Zine
SUBMISSION_EMAIL_BODY=Thank you for submitting to Rage Zine.
