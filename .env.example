# Copy this file to .env on the server and replace every required placeholder.
# Never commit .env. Docker Compose reads this file from the project root.

# Django (required for production)
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=submissions.danielgalfert.com,admin.submissions.danielgalfert.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://submissions.danielgalfert.com,https://admin.submissions.danielgalfert.com

# PostgreSQL (required by docker-compose.yml)
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=submissions
POSTGRES_USER=ragezine
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Public HTTPS hostname. Point its DNS A record at the Lightsail static IP.
RAGEZINE_PUBLIC_HOST=submissions.danielgalfert.com
RAGEZINE_ADMIN_HOST=admin.submissions.danielgalfert.com

# Rate limits. Docker Compose supplies RAGEZINE_REDIS_URL automatically.
# A non-Compose production deployment must set a shared Redis URL.
# RAGEZINE_REDIS_URL=redis://127.0.0.1:6379/0
# RAGEZINE_PROXY_COUNT=1
RAGEZINE_SUBMISSION_RATE=5/hour
RAGEZINE_LOGIN_IP_RATE=15/minute
RAGEZINE_LOGIN_USERNAME_RATE=8/minute
RAGEZINE_EXPORT_RATE=20/hour

# nginx limits for sudden bursts before requests reach Django.
RAGEZINE_NGINX_LOGIN_RATE=15r/m
RAGEZINE_NGINX_LOGIN_BURST=8
RAGEZINE_NGINX_SUBMISSION_RATE=5r/m
RAGEZINE_NGINX_SUBMISSION_BURST=5

# Submission files: each file, all files combined, and the proxy request body.
# Keep the proxy cap above the combined file cap to allow multipart form fields.
RAGEZINE_MAX_FILE_MB=5120
RAGEZINE_MAX_TOTAL_FILES_MB=10240
RAGEZINE_NGINX_MAX_BODY_SIZE=11g
RAGEZINE_NGINX_PROXY_READ_TIMEOUT=14400s
RAGEZINE_GUNICORN_TIMEOUT=14400

# Private loopback HTTP port of the Compose nginx service.
RAGEZINE_HTTP_PORT=8080

# Private submission files. The local option uses the persistent media_data volume.
RAGEZINE_STORAGE_BACKEND=local
# For private S3-compatible storage instead of local files, set the backend to s3
# and configure the settings below. Keep the bucket private.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_QUERYSTRING_AUTH=1

# Artist receipt email (required if email delivery is enabled)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
SUBMISSION_EMAIL_FROM=
SUBMISSION_EMAIL_SUBJECT=Thank you for submitting to Rage Zine
SUBMISSION_EMAIL_BODY=Thank you for submitting to Rage Zine.

# One-time superuser bootstrap only; add these temporarily when running
# `docker compose run --rm --no-deps backend python manage.py createsuperuser --noinput`,
# then remove them from .env.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
