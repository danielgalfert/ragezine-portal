DJANGO_DB_ENGINE=postgres

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_MEDIA_URL=/media/
RAGEZINE_STORAGE_BACKEND=local

# S3-compatible storage, for later:
# RAGEZINE_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=auto
# AWS_QUERYSTRING_AUTH=1

POSTGRES_DB=submissions
POSTGRES_USER=ragezine
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Rate limits. Docker Compose supplies RAGEZINE_REDIS_URL automatically.
# A non-Compose production deployment must set a shared Redis URL.
# RAGEZINE_REDIS_URL=redis://127.0.0.1:6379/0
# RAGEZINE_PROXY_COUNT=1
RAGEZINE_SUBMISSION_RATE=5/hour
RAGEZINE_LOGIN_IP_RATE=15/minute
RAGEZINE_LOGIN_USERNAME_RATE=8/minute
RAGEZINE_EXPORT_RATE=20/hour

# nginx limits for sudden bursts before requests reach Django.
RAGEZINE_NGINX_LOGIN_RATE=15r/m
RAGEZINE_NGINX_LOGIN_BURST=8
RAGEZINE_NGINX_SUBMISSION_RATE=5r/m
RAGEZINE_NGINX_SUBMISSION_BURST=5

# Submission files: each file, all files combined, and the proxy request body.
# Keep the proxy cap above the combined file cap to allow multipart form fields.
RAGEZINE_MAX_FILE_MB=20
RAGEZINE_MAX_TOTAL_FILES_MB=50
RAGEZINE_NGINX_MAX_BODY_SIZE=55m
